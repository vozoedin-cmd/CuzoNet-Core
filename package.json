{
  "name": "cuzonet",
  "version": "0.1.0",
  "private": true,
  "description": "ERP especializado para WISP.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch backend/server.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "pino": "^9.9.4",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.3",
    "eslint": "~10.6.0",
    "prettier": "~3.9.4",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.62.1",
    "vitest": "^3.2.4"
  }
}
