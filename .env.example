APP_NAME=CuzoNet
NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000
TIMEZONE=America/Guatemala
LOG_LEVEL=info
DATABASE_PATH=./storage/cuzonet.sqlite
DATABASE_BUSY_TIMEOUT_MS=5000
DATABASE_BACKUP_PATH=./storage/backups
MONITORING_PING_TIMEOUT_MS=3000
# MONITORING_SNMP_COMMUNITY=change-me
MONITORING_SNMP_TIMEOUT_MS=3000
MONITORING_SNMP_RETRIES=1
# MONITORING_ROUTEROS_HOST=router.example.com
# MONITORING_ROUTEROS_USERNAME=monitoring
# MONITORING_ROUTEROS_PASSWORD=change-me
# MONITORING_ROUTEROS_PORT=8729
MONITORING_ROUTEROS_TLS=true
MONITORING_ROUTEROS_TIMEOUT_MS=5000

# Notification workers are disabled by default; no external sends occur unless explicitly enabled.
NOTIFICATION_WORKER_ENABLED=false
NOTIFICATION_WORKER_INTERVAL_MS=5000
NOTIFICATION_WORKER_BATCH_SIZE=20
NOTIFICATION_WORKER_LEASE_SECONDS=60
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_WEBHOOK_TIMEOUT_MS=5000
NOTIFICATION_WEBHOOK_ALLOW_HTTP=false

# Automation workers are disabled by default.
AUTOMATION_WORKER_ENABLED=false
AUTOMATION_WORKER_INTERVAL_MS=5000
AUTOMATION_WORKER_BATCH_SIZE=20
AUTOMATION_WORKER_LEASE_SECONDS=60
AUTOMATION_MAX_ATTEMPTS=5
AUTOMATION_MAX_CAUSAL_DEPTH=5

# Provisioning workers are disabled by default.
PROVISIONING_WORKER_ENABLED=false
PROVISIONING_WORKER_INTERVAL_MS=5000
PROVISIONING_WORKER_BATCH_SIZE=20
PROVISIONING_WORKER_LEASE_SECONDS=60
PROVISIONING_MAX_ATTEMPTS=5

# RouterOS provisioning is disabled by default.
ROUTEROS_PROVISIONING_ENABLED=false
ROUTEROS_CONNECT_TIMEOUT_MS=5000
ROUTEROS_COMMAND_TIMEOUT_MS=10000
ROUTEROS_MAX_CONNECTIONS=5
ROUTEROS_TLS_VERIFY=true

# A destination stores only configurationReference=WEBHOOK_OPERATIONS.
# The credential provider resolves the following values at runtime:
# WEBHOOK_OPERATIONS_URL=https://notifications.example.com/incidents
# WEBHOOK_OPERATIONS_BEARER_TOKEN=change-me

NOTIFICATION_WHATSAPP_ALLOW_HTTP=false
NOTIFICATION_WHATSAPP_TIMEOUT_MS=5000
# WHATSAPP_OPERATIONS_BASE_URL=https://evolution.example.com
# WHATSAPP_OPERATIONS_API_KEY=change-me
# WHATSAPP_OPERATIONS_INSTANCE_NAME=cuzonet
# WHATSAPP_OPERATIONS_DEFAULT_COUNTRY_CODE=502
# WHATSAPP_OPERATIONS_TIMEOUT_MS=5000

# Telegram and Email adapters are intentionally disabled in this version.
# TELEGRAM_OPERATIONS_BOT_TOKEN=change-me
# EMAIL_OPERATIONS_SMTP_PASSWORD=change-me